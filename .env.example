# Copy this file to .env and fill in your Supabase project's values.
# See supabase/README.md for how to provision the project (migration, realtime, invitation function).

# Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> anon / publishable key
# Safe to ship in the client: RLS and the RPC layer enforce all access control.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
